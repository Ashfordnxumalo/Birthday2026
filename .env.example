# =============================================================
#  Copy this file to ".env" and fill in your real values.
#  Never commit ".env" to git. Vite only exposes vars prefixed VITE_.
# =============================================================

# --- Formspree ---
# 1. Create a free account at https://formspree.io
# 2. Create a new form; copy its endpoint (looks like https://formspree.io/f/abcdwxyz)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# --- EmailJS (guest confirmation emails) ---
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (Gmail, Outlook, etc.) -> copy the Service ID
# 3. Create an Email Template (see README) -> copy the Template ID
# 4. Account -> API Keys -> copy the Public Key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# --- Firebase Realtime Database (event-night Story Wall + live programme) ---
# 1. https://console.firebase.google.com -> Add project -> Build -> Realtime Database -> Create
# 2. Copy the database URL (e.g. https://my-party-default-rtdb.europe-west1.firebasedatabase.app)
# 3. Paste firebase.rules.json into the database's "Rules" tab and Publish
VITE_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com

# --- Programme Director controls ---
# Open the site with ?mc=<this PIN> to move the "Now happening" marker and remove stories.
VITE_MC_PIN=change-me
