{
  "rules": {
    "stories": {
      ".read": true,
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['name', 'table', 'story', 'device', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "table": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "story": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280"
        },
        "device": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "hearts": {
          "$device": {
            ".write": true,
            ".validate": "newData.val() === true && $device.length <= 40"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      ".read": true,
      "programme": {
        ".write": true,
        ".validate": "newData.hasChildren(['index']) && newData.child('index').isNumber()"
      },
      "programmeData": {
        ".write": true,
        "$act": {
          ".validate": "newData.hasChildren(['act', 'items'])",
          "act": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "items": {
            "$item": {
              ".validate": "newData.hasChildren(['title'])",
              "title": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "person": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "messages": {
                "$m": {
                  ".validate": "newData.hasChildren(['from'])",
                  "from": {
                    ".validate": "newData.isString() && newData.val().length <= 60"
                  },
                  "person": {
                    ".validate": "newData.isString() && newData.val().length <= 80"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
